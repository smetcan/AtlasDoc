# AtlasDoc Giriş Bilgileri (Bu dosyayı .env olarak kopyalayıp kendi bilgilerinizi girin)
ATLASDOC_AUTH_USER=
ATLASDOC_AUTH_PASS=

# Opsiyonel: Oturum çerezi imzalama anahtarı (boş bırakılırsa şifreden türetilir)
ATLASDOC_AUTH_SECRET=

# Bulut Vision LLM Sağlayıcı API Anahtarları
# (Burada tanımlanan anahtarlar sunucu tarafında doğrudan kullanılır; arayüzde tekrar girmeye gerek kalmaz)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
