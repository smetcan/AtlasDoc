{
  "private": true,
  "description": "Rebuilds the committed Tailwind CSS. The browser never runs this.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i input.css -o ../atlasdoc/static/vendor/tailwind.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.19",
    "tailwindcss": "3.4.19"
  }
}
